# Data — raw data is not committed
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Model artifacts
models/*.pkl
models/*.joblib

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Environments
.env
.venv
env/
venv/
.conda/

# IDE
.claude/
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Pytest
.pytest_cache/
.coverage
htmlcov/

# Streamlit
.streamlit/

# External source caches - keep large/downloaded source products out of Git
data/external/mura_2024/*.html
data/external/mura_2024/*.pdf
data/external/mura_2024/*_layout.txt
data/external/galileo_nims/products/
data/external/galileo_nims/labels/
data/external/galileo_nims/*.xlsx
data/external/galileo_nims/sample_*.csv
data/external/galileo_nims/sample_*.xml
data/external/ao_dekleer/*.pdf
data/external/ao_dekleer/*_layout.txt
